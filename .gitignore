# ==============================================================================
# Git Ignore for ShopSmart RAG Project
# ==============================================================================

# --- Secrets & Environment Variables ---
.env
.env*.local
.env.*
!.env.example
*.pem
*.key

# --- Python Virtual Environments ---
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# --- Python Cache & Build Artifacts ---
__pycache__/
*.py[cod]
*$py.class
*.so
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# --- Vector Database & Model Weights ---
