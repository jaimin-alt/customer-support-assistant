chroma_db/
.cache/
huggingface/

# --- Testing, Coverage & Linters ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# --- IDEs & Text Editors ---
.vscode/
.idea/
*.swp
*.swo
*~
.project
.pydevproject
.settings/

# --- Operating System Artifacts ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
